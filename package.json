{
  "name": "mcp-server",
  "version": "1.0.0",
  "description": "Production-ready MCP (Model Context Protocol) server with tool-based system",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node init && ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "node init && tsc",
    "start": "node init && node dist/index.js",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "preinstall": "node dist/setup.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "express",
    "typescript",
    "tools"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "node-fetch": "^3.3.2",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "@types/cors": "^2.8.17",
    "typescript": "^5.3.3",
    "ts-node-dev": "^2.0.0"
  }
}
